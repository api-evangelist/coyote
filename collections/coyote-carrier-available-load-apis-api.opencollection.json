                "description": "Requested page"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Requested page size"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Allows Carriers to search for available loads with a set of query inputs. Coyote will return the list of all available loads that match the inputs provided in the request."
